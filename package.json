{
  "name": "typed-controls",
  "description": "typed controls, widgets and others",
  "version": "0.12.7",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": "codenautas/typed-controls",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    },
    {
      "name": "Estefanía Capece",
      "email": "eycapece@gmail.com"
    },
    {
      "name": "Diego Florio",
      "email": "diegoefe@gmail.com"
    },
    {
      "name": "Manuel De la Penna",
      "email": "manueldelapenna@gmail.com"
    }
  ],
  "main": "lib/typed-controls.js",
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "dependencies": {
    "best-globals": "^2.2.3",
    "js-to-html": "^1.5.0",
    "like-ar": "^0.5.4",
    "pikaday": "^1.8.2",
    "type-store": "^0.6.3"
  },
  "devDependencies": {
    "big.js": "^7.0.1",
    "discrepances": "^0.3.2",
    "esprima": "^4.0.1",
    "expect.js": "^0.3.1",
    "express-useragent": "^2.2.3",
    "json4all": "^1.4.6",
    "mocha": "^12.0.3",
    "moment": "^2.31.0",
    "nyc": "^18.0.0",
    "require-bro": "^0.4.1",
    "qa-control": "^0.12.2",
    "self-explain": "^0.11.0",
    "server4test": "^2.0.0"
  },
  "optionalDependencies": {
    "castellano": "~0.1.7",
    "dialog-promise": "~0.11.0"
  },
  "engines": {
    "node": ">= 14"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build-test": "nyc instrument --delete lib/typed-controls.js local-instrumented",
    "test": "npm run test-navigator",
    "test-ci": "npm run test-navigator && nyc report",
    "test-navigator": "npm run build-test && server4test --run-browser chrome,firefox",
    "test-navigator-inf": "npm run build-test && server4test",
    "start": "server4test",
    "all": "npm test && qa-control . -v",
    "report": "nyc report"
  },
  "qa-control": {
    "coverage": 100,
    "run-in": "both",
    "type": "lib",
    "gha": "all",
    "silenced": [
      "eslint_warnings_in_file_1"
    ]
  }
}
